<?xml version="1.0" encoding="utf-8"?>
<!--
  This manifest builds the runtime APK whose compiled resources and dex
  Enginehost attaches to its own runtime process; it is never installed as an
  app of its own, so there is no launcher activity, no provider and no
  permission here. The host holds the storage permissions and hands this
  activity a path it may already read.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="ONScripter">
        <activity
            android:name="com.yuri.onscripter.ONScripter"
            android:exported="true"
            android:theme="@style/EnginehostONScripterActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard" />
    </application>
</manifest>
